# Copy this file to .env.local and fill your local secrets.
# .env.local is ignored by git.

MCBOT_DEFAULT_ENABLED=true
MCBOT_DEFAULT_BOT_ID=XiaoLi_26.3.3_newnancity
MCBOT_DEFAULT_AUTH_API_BASE_URL=https://authmc.newnan.city
MCBOT_DEFAULT_USERNAME=<your-username-or-email>
MCBOT_DEFAULT_PASSWORD=<your-password>
MCBOT_DEFAULT_SERVER_HOST=main.newnan.city
MCBOT_DEFAULT_USE_SRV=true
MCBOT_DEFAULT_VERSION=1.20.1
MCBOT_DEFAULT_AUTO_CONNECT=true
MCBOT_DEFAULT_AUTO_CONNECT_DELAY_MS=5000

# Optional, used by chat.ai and agent planner.
MCBOT_AI_API_BASE_URL=https://api.openai.com/v1
MCBOT_AI_API_KEY=<your-ai-api-key>
# Optional model request timeouts in milliseconds.
MCBOT_AI_REQUEST_TIMEOUT_MS=15000
# Optional per-layer overrides:
# MCBOT_CHAT_AI_TIMEOUT_MS=15000
# MCBOT_PLANNER_TIMEOUT_MS=15000
# MCBOT_MEMORY_SUMMARY_TIMEOUT_MS=15000

# Optional shared XiaoLi memory root. McBot prompt profile defaults to
# C:\xiaoli\memory\prompts\mcbot-prompt-profile.json.
XIAOLI_MEMORY_DIR=C:\xiaoli\memory

# Optional, auto-enable in-game fixed replies / command listener for the default bot.
MCBOT_DEFAULT_CHAT_LISTENER_ENABLED=true
MCBOT_DEFAULT_CHAT_WHITELIST=Judy
MCBOT_DEFAULT_CHAT_WAKE_NAMES=小狸
MCBOT_DEFAULT_CHAT_HI_REPLY=hihi

# Optional, auto-enable in-game AI small-talk for the default bot.
# This still requires MCBOT_AI_API_KEY.
MCBOT_DEFAULT_CHAT_AI_ENABLED=false
MCBOT_DEFAULT_CHAT_AI_WHITELIST=Judy
MCBOT_DEFAULT_CHAT_AI_WAKE_WORD=小狸
MCBOT_DEFAULT_CHAT_AI_MODEL=gpt-5-nano

# Optional debug panel settings.
MCBOT_DEBUG_WEB_ENABLED=true
MCBOT_DEBUG_WEB_HOST=127.0.0.1
MCBOT_DEBUG_WEB_PORT=4637
# Required when binding the debug panel to a non-loopback host.
# Open http://<host>:<port>/?token=<this-token> once in a browser.
# MCBOT_DEBUG_WEB_AUTH_TOKEN=<local-debug-token>
# MCBOT_DEBUG_WEB_ALLOWED_ORIGINS=http://127.0.0.1:4637
# MCBOT_DEBUG_WEB_MAX_BODY_BYTES=65536
